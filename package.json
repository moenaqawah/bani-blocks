{
  "name": "bani-blocks",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "_note": "always invoke as `pnpm run <script>` \u2014 `pnpm deploy` collides with pnpm's built-in deploy command",
    "migrate": "pnpm --filter @bani/reservation-demo exec tsx scripts/migrate.ts",
    "dev": "pnpm --filter @bani/reservation-demo exec wrangler dev",
    "deploy": "pnpm --filter @bani/reservation-demo exec wrangler deploy",
    "smoke": "pnpm --filter @bani/reservation-demo exec tsx scripts/smoke.ts",
    "evals": "pnpm --filter @bani/reservation-demo exec tsx scripts/evals.ts",
    "test": "pnpm --filter @bani/reservation-demo exec node --import tsx --test \"../../packages/*/test/*.test.ts\" \"test/*.test.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1"
  }
}
