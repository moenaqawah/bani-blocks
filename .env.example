# === Database ===
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# === WhatsApp / Meta ===
WHATSAPP_VERIFY_TOKEN=bani-demo-verify-8213
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=9f8c...

# === WhatsApp Graph API version (plain var, not a secret) ===
WHATSAPP_GRAPH_VERSION=v25.0

# === AI Provider ===
# One of: google | openai | anthropic | groq
AI_PROVIDER=google
AI_MODEL=gemini-flash-latest

# === AI API keys (only the active provider's key is required) ===
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# === AI rate limit (requests per minute) ===
AI_MAX_RPM=10

# === Google Calendar ===
GCAL_CALENDAR_ID=abc123@group.calendar.google.com
GCAL_SA_EMAIL=bani-demo@bani-demo.iam.gserviceaccount.com
GCAL_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n

# === Demo allowlist (comma-separated E.164 numbers, no +; empty = allow all) ===
DEMO_ALLOWLIST=

# === Agent config ===
AGENT_HISTORY_LIMIT=20
AGENT_HISTORY_MAX_AGE_HOURS=6

# === Logging ===
LOG_LEVEL=info
